{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "GITADF99"
		},
		"empgenls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'empgenls'"
		},
		"gitemp_ls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'gitemp_ls'"
		},
		"empgenls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://hari100adlsstg.dfs.core.windows.net/"
		},
		"gitemp_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://hari100adlsstg.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "GITADF99_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"empgenls_accountKey": {
						"value": "[parameters('empgenls_accountKey')]"
					},
					"gitemp_ls_accountKey": {
						"value": "[parameters('gitemp_ls_accountKey')]"
					},
					"empgenls_properties_typeProperties_url": {
						"value": "[parameters('empgenls_properties_typeProperties_url')]"
					},
					"gitemp_ls_properties_typeProperties_url": {
						"value": "[parameters('gitemp_ls_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}